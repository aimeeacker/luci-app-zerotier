#!/bin/sh

# Ensure persistent directory exists
mkdir -p /etc/zerotier

# Symlink /var/lib/zerotier-one to /etc/zerotier if not already done
if [ ! -L /var/lib/zerotier-one ] && [ ! -d /var/lib/zerotier-one ]; then
	mkdir -p /var/lib
	ln -s /etc/zerotier /var/lib/zerotier-one
fi

# Ensure correct executable permissions
chmod +x /usr/libexec/rpcd/zerotier-controller 2>/dev/null || true

exit 0
