#!/usr/bin/ucode
/* SPDX-License-Identifier: Apache-2.0 */

import { readfile, popen, stat, statvfs, open, unlink, access } from 'fs';

function trim(s) {
	return s ? replace(s, /^[\s\r\n]+|[\s\r\n]+$/g, '') : '';
}

function get_token() {
	let token = getenv('ZT_CONTROLLER_TOKEN');
	if (token) return trim(token);
	let secret = readfile('/var/lib/zerotier-one/authtoken.secret') || readfile('/etc/zerotier/authtoken.secret');
	return secret ? trim(secret) : '';
}

function json_error(message, method, path, http_status) {
	return {
		error: message || 'Unknown error',
		method: method || '',
		path: path || '',
		http_status: http_status || 0
	};
}

function valid_nwid(nwid) {
	return type(nwid) == 'string' && match(nwid, /^[0-9a-fA-F]{16}$/) != null;
}

function valid_nodeid(nodeid) {
	return type(nodeid) == 'string' && match(nodeid, /^[0-9a-fA-F]{10}$/) != null;
}

function ipv4_from_int(val) {
	let a = int(val / 16777216) % 256;
	let b = int(val / 65536) % 256;
	let c = int(val / 256) % 256;
	let d = int(val) % 256;
	return sprintf('%d.%d.%d.%d', a, b, c, d);
}

function parse_ipv4_cidr(cidr) {
	if (type(cidr) != 'string') return null;
	let m = match(cidr, /^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\/([0-9]{1,2})$/);
	if (!m) return null;

	let a = int(m[1]), b = int(m[2]), c = int(m[3]), d = int(m[4]), prefix = int(m[5]);
	if (a > 255 || b > 255 || c > 255 || d > 255 || prefix < 8 || prefix > 30) return null;

	let ip_val = a * 16777216 + b * 65536 + c * 256 + d;
	let block_size = 1 << (32 - prefix);
	let net_val = int(ip_val / block_size) * block_size;
	let broadcast_val = net_val + block_size - 1;

	return {
		network: ipv4_from_int(net_val),
		prefix: prefix,
		first: ipv4_from_int(net_val + 1),
		last: ipv4_from_int(broadcast_val - 1),
		normalized: sprintf('%s/%d', ipv4_from_int(net_val), prefix)
	};
}

function shell_escape(s) {
	let str = (s == null) ? '' : sprintf('%s', s);
	return "'" + replace(str, /'/g, "'\\''") + "'";
}

function zt_api(method, path, data) {
	let token = get_token();
	if (!token)
		return json_error('authtoken.secret not found', method, path, 0);

	let cmd = sprintf("curl -sS -w '\\n%%{http_code}' -X %s -H %s", shell_escape(method), shell_escape('X-ZT1-AUTH: ' + token));
	if (data != null) {
		let payload = (type(data) == 'string') ? data : sprintf('%J', data);
		cmd += sprintf(" -H 'Content-Type: application/json' -d %s", shell_escape(payload));
	}
	cmd += sprintf(" %s", shell_escape('http://127.0.0.1:9993' + path));

	let proc = popen(cmd, 'r');
	if (!proc)
		return json_error('failed to execute curl', method, path, 0);

	let output = proc.read('all') || '';
	proc.close();

	let lines = split(output, '\n');
	let http_code = 0;
	if (length(lines) > 0) {
		http_code = int(lines[length(lines) - 1]) || 0;
		lines = slice(lines, 0, length(lines) - 1);
	}
	let body_str = join('\n', lines);

	if (http_code >= 200 && http_code < 300) {
		if (!body_str || trim(body_str) == '')
			return {};
		let parsed = json(body_str);
		return (parsed != null) ? parsed : json_error('ZeroTier API returned invalid JSON', method, path, http_code);
	} else {
		let err_obj = json(body_str);
		let msg = (type(err_obj) == 'object') ? (err_obj.error || err_obj.message || err_obj.description) : null;
		return json_error(msg || 'ZeroTier API request failed', method, path, http_code);
	}
}

function check_dir_writable(dir) {
	if (!dir || !stat(dir)) return false;
	let test_file = dir + '/.ztc_write_test_' + sprintf('%d', int(rand() * 100000));
	let f = open(test_file, 'w');
	if (!f) return false;
	f.write('test');
	f.close();
	unlink(test_file);
	return true;
}

function get_storage_info() {
	let zt_dir = stat('/var/lib/zerotier-one') ? '/var/lib/zerotier-one' : (stat('/etc/zerotier') ? '/etc/zerotier' : null);
	let token_path = zt_dir ? zt_dir + '/authtoken.secret' : null;
	let token_present = token_path ? stat(token_path) != null : false;
	let writable = zt_dir ? check_dir_writable(zt_dir) : false;
	let vfs = zt_dir ? statvfs(zt_dir) : null;
	let free_space = vfs ? (vfs.bavail * vfs.frsize) : -1;

	return {
		storagePath: zt_dir,
		tokenPresent: token_present,
		storageWritable: writable,
		freeSpaceBytes: free_space
	};
}

function read_rpc_input() {
	let path = getenv('ZT_RPC_INPUT_FILE');
	let input_str = path ? readfile(path) : null;
	if (input_str == null || trim(input_str) == '')
		input_str = readfile('/dev/stdin') || '';
	if (!input_str || trim(input_str) == '') return {};
	return json(input_str) || {};
}

function is_peer_online(peer, nodeid, nwid) {
	if (nwid && nodeid && valid_nodeid(nodeid) && lc(nodeid) == lc(substr(nwid, 0, 10)))
		return true;
	if (!peer || type(peer) != 'object') return false;
	if (peer.latency != null && int(peer.latency) >= 0) return true;
	let paths = peer.paths || [];
	if (type(paths) == 'array' && length(paths) > 0) {
		for (let p in paths) {
			if (p && (p.active == true || p.preferred == true)) return true;
		}
	}
	return false;
}

let action = ARGV[1];
let method = ARGV[2];

if (action == 'list') {
	let methods = {
		status: {},
		list_networks: {},
		get_network_info: { nwid: 'string' },
		create_network: { name: 'string', cidr: 'string' },
		update_ip_pool: { nwid: 'string', cidr: 'string', old_cidr: 'string' },
		list_members: { nwid: 'string', online_only: 'boolean' },
		authorize_member: { nwid: 'string', nodeid: 'string', authorized: 'boolean' },
		change_member_ip: { nwid: 'string', nodeid: 'string', ip_assignments: 'array' },
		rename_member: { nwid: 'string', nodeid: 'string', name: 'string' },
		add_route: { nwid: 'string', target: 'string', via: 'string' },
		del_route: { nwid: 'string', target: 'string' },
		delete_member: { nwid: 'string', nodeid: 'string' },
		export_backup: { nwid: 'string' },
		import_backup: { backup_data: 'string' }
	};
	print(sprintf('%J\n', methods));
	exit(0);
}

if (action == 'call') {
	let input = read_rpc_input();

	if (method == 'status') {
		let storage = get_storage_info();
		let node_res = zt_api('GET', '/status');
		if (node_res.error) {
			print(sprintf('%J\n', {
				online: false,
				controller: false,
				databaseReady: false,
				error: node_res.error,
				storagePath: storage.storagePath,
				tokenPresent: storage.tokenPresent,
				storageWritable: storage.storageWritable,
				freeSpaceBytes: storage.freeSpaceBytes
			}));
			exit(0);
		}
		let ctrl_res = zt_api('GET', '/controller');
		if (ctrl_res.error) {
			print(sprintf('%J\n', {
				address: node_res.address,
				version: node_res.version,
				online: node_res.online,
				controller: false,
				databaseReady: false,
				controllerError: ctrl_res.error,
				controllerHttpStatus: ctrl_res.http_status,
				storagePath: storage.storagePath,
				tokenPresent: storage.tokenPresent,
				storageWritable: storage.storageWritable,
				freeSpaceBytes: storage.freeSpaceBytes
			}));
			exit(0);
		}
		print(sprintf('%J\n', {
			address: node_res.address,
			version: node_res.version,
			online: node_res.online,
			controller: ctrl_res.controller == true,
			databaseReady: ctrl_res.databaseReady == true,
			controllerApiVersion: ctrl_res.apiVersion,
			storagePath: storage.storagePath,
			tokenPresent: storage.tokenPresent,
			storageWritable: storage.storageWritable,
			freeSpaceBytes: storage.freeSpaceBytes
		}));
		exit(0);
	}

	if (method == 'list_networks') {
		let res = zt_api('GET', '/controller/network');
		if (res.error) {
			print(sprintf('%J\n', { networks: [], error: res.error }));
			exit(0);
		}
		let network_ids = [];
		if (type(res) == 'array') network_ids = res;
		else if (type(res) == 'object') network_ids = keys(res);

		let networks = [];
		for (let nwid in network_ids) {
			let id = type(nwid) == 'object' ? (nwid.id || nwid.nwid) : nwid;
			if (!valid_nwid(id)) continue;
			let net_detail = zt_api('GET', '/controller/network/' + id);
			let name = (type(net_detail) == 'object' && !net_detail.error) ? (net_detail.name || '') : '';
			push(networks, { id: id, name: name });
		}
		print(sprintf('%J\n', { networks: networks }));
		exit(0);
	}

	if (method == 'get_network_info') {
		let nwid = input.nwid;
		if (!valid_nwid(nwid)) {
			print('{"error": "missing nwid"}\n');
			exit(0);
		}
		let res = zt_api('GET', '/controller/network/' + nwid);
		print(sprintf('%J\n', res));
		exit(0);
	}

	if (method == 'create_network') {
		let name = trim(input.name) || 'new_network';
		let cidr = trim(input.cidr);
		if (!cidr) {
			let r1 = int(rand() * 120) + 100;
			let r2 = int(rand() * 250) + 1;
			cidr = sprintf('10.%d.%d.0/24', r1, r2);
		}
		let parsed = parse_ipv4_cidr(cidr);
		if (!parsed) {
			print('{"error": "IPv4 CIDR must use a prefix between /8 and /30"}\n');
			exit(0);
		}
		let payload = {
			name: name,
			private: true,
			v4AssignMode: { zt: true },
			ipAssignmentPools: [{ ipRangeStart: parsed.first, ipRangeEnd: parsed.last }],
			routes: [{ target: parsed.normalized, via: null }]
		};
		let res = zt_api('POST', '/controller/network', payload);
		print(sprintf('%J\n', res));
		exit(0);
	}

	if (method == 'update_ip_pool') {
		let nwid = input.nwid;
		let cidr = input.cidr;
		let old_cidr = input.old_cidr || '';
		if (!valid_nwid(nwid)) {
			print('{"error": "invalid network ID"}\n');
			exit(0);
		}
		let parsed = parse_ipv4_cidr(cidr);
		if (!parsed) {
			print('{"error": "IPv4 CIDR must use a prefix between /8 and /30"}\n');
			exit(0);
		}
		let net_json = zt_api('GET', '/controller/network/' + nwid);
		if (net_json.error) {
			print(sprintf('%J\n', net_json));
			exit(0);
		}

		let current_routes = net_json.routes || [];
		let new_routes = [];
		for (let r in current_routes) {
			if (r.target == parsed.normalized) continue;
			if (old_cidr != '' && r.target == old_cidr && r.via == null) continue;
			push(new_routes, r);
		}
		push(new_routes, { target: parsed.normalized, via: null });

		let payload = {
			v4AssignMode: (net_json.v4AssignMode || {}) + { zt: true },
			ipAssignmentPools: [{ ipRangeStart: parsed.first, ipRangeEnd: parsed.last }],
			routes: new_routes
		};

		let res = zt_api('POST', '/controller/network/' + nwid, payload);
		if (res.error) {
			print(sprintf('%J\n', res));
		} else {
			res.cidr = parsed.normalized;
			res.ipRangeStart = parsed.first;
			res.ipRangeEnd = parsed.last;
			print(sprintf('%J\n', res));
		}
		exit(0);
	}

	if (method == 'list_members') {
		let nwid = input.nwid;
		let online_only = input.online_only == true;
		if (!valid_nwid(nwid)) {
			print('{"error": "missing nwid"}\n');
			exit(0);
		}
		let members_index = zt_api('GET', '/controller/network/' + nwid + '/member');
		if (members_index.error) {
			print(sprintf('%J\n', { members: [], peers: [], error: members_index.error }));
			exit(0);
		}
		let peers_list = zt_api('GET', '/peer');
		if (peers_list.error) peers_list = [];

		let online_peers_map = {};
		let ctrl_nodeid = lc(substr(nwid, 0, 10));
		online_peers_map[ctrl_nodeid] = true;

		if (type(peers_list) == 'array') {
			for (let peer in peers_list) {
				if (peer.address && is_peer_online(peer, peer.address, nwid))
					online_peers_map[lc(peer.address)] = true;
			}
		}

		let node_ids = keys(members_index || {});
		let members_list = [];
		for (let nodeid in node_ids) {
			if (online_only && !online_peers_map[lc(nodeid)]) continue;
			let member = zt_api('GET', '/controller/network/' + nwid + '/member/' + nodeid);
			if (!member.error) push(members_list, member);
		}
		print(sprintf('%J\n', { members: members_list, peers: peers_list }));
		exit(0);
	}

	if (method == 'authorize_member') {
		let nwid = input.nwid, nodeid = input.nodeid, authorized = input.authorized == true;
		if (!valid_nwid(nwid) || !valid_nodeid(nodeid)) {
			print('{"error": "invalid parameter"}\n');
			exit(0);
		}
		let res = zt_api('POST', '/controller/network/' + nwid + '/member/' + nodeid, { authorized: authorized });
		print(sprintf('%J\n', res));
		exit(0);
	}

	if (method == 'change_member_ip') {
		let nwid = input.nwid, nodeid = input.nodeid, ips = input.ip_assignments || [];
		if (!valid_nwid(nwid) || !valid_nodeid(nodeid)) {
			print('{"error": "invalid parameter"}\n');
			exit(0);
		}
		let res = zt_api('POST', '/controller/network/' + nwid + '/member/' + nodeid, { ipAssignments: ips });
		print(sprintf('%J\n', res));
		exit(0);
	}

	if (method == 'rename_member') {
		let nwid = input.nwid, nodeid = input.nodeid, name = input.name || '';
		if (!valid_nwid(nwid) || !valid_nodeid(nodeid)) {
			print('{"error": "invalid parameter"}\n');
			exit(0);
		}
		let res = zt_api('POST', '/controller/network/' + nwid + '/member/' + nodeid, { name: name });
		print(sprintf('%J\n', res));
		exit(0);
	}

	if (method == 'add_route') {
		let nwid = input.nwid, target = input.target, via = input.via || null;
		if (!valid_nwid(nwid) || !target) {
			print('{"error": "invalid parameter"}\n');
			exit(0);
		}
		let net_json = zt_api('GET', '/controller/network/' + nwid);
		if (net_json.error) {
			print(sprintf('%J\n', net_json));
			exit(0);
		}
		let current_routes = net_json.routes || [];
		let updated_routes = [];
		for (let r in current_routes) {
			if (r.target != target) push(updated_routes, r);
		}
		push(updated_routes, { target: target, via: via });
		let res = zt_api('POST', '/controller/network/' + nwid, { routes: updated_routes });
		print(sprintf('%J\n', res));
		exit(0);
	}

	if (method == 'del_route') {
		let nwid = input.nwid, target = input.target;
		if (!valid_nwid(nwid) || !target) {
			print('{"error": "invalid parameter"}\n');
			exit(0);
		}
		let net_json = zt_api('GET', '/controller/network/' + nwid);
		if (net_json.error) {
			print(sprintf('%J\n', net_json));
			exit(0);
		}
		let current_routes = net_json.routes || [];
		let updated_routes = [];
		for (let r in current_routes) {
			if (r.target != target) push(updated_routes, r);
		}
		let res = zt_api('POST', '/controller/network/' + nwid, { routes: updated_routes });
		print(sprintf('%J\n', res));
		exit(0);
	}

	if (method == 'delete_member') {
		let nwid = input.nwid, nodeid = input.nodeid;
		if (!valid_nwid(nwid) || !valid_nodeid(nodeid)) {
			print('{"error": "invalid parameter"}\n');
			exit(0);
		}
		let res = zt_api('DELETE', '/controller/network/' + nwid + '/member/' + nodeid);
		print(sprintf('%J\n', res));
		exit(0);
	}

	if (method == 'export_backup') {
		let nwid = input.nwid;
		if (!valid_nwid(nwid)) {
			print('{"error": "missing nwid"}\n');
			exit(0);
		}
		let net_detail = zt_api('GET', '/controller/network/' + nwid);
		if (net_detail.error) {
			print(sprintf('%J\n', net_detail));
			exit(0);
		}
		let members_index = zt_api('GET', '/controller/network/' + nwid + '/member');
		let members = {};
		if (!members_index.error && type(members_index) == 'object') {
			for (let nodeid in keys(members_index)) {
				let m = zt_api('GET', '/controller/network/' + nwid + '/member/' + nodeid);
				if (!m.error) members[nodeid] = m;
			}
		}
		print(sprintf('%J\n', {
			nwid: nwid,
			backup_time: sprintf('%s', strftime('%Y-%m-%d %H:%M:%S')),
			network: net_detail,
			members: members
		}));
		exit(0);
	}

	if (method == 'import_backup') {
		let backup_str = input.backup_data || '';
		if (length(backup_str) > 2097152) {
			print('{"error": "Backup payload exceeds 2 MB limit"}\n');
			exit(0);
		}
		let backup = json(backup_str);
		if (!backup || type(backup) != 'object' || !backup.network) {
			print('{"error": "invalid backup payload"}\n');
			exit(0);
		}
		let net = backup.network;
		let orig_nwid = backup.nwid || net.id || net.nwid;
		let create_res = zt_api('POST', '/controller/network', net);
		if (create_res.error) {
			print(sprintf('%J\n', create_res));
			exit(0);
		}
		let new_nwid = create_res.id || create_res.nwid || orig_nwid;
		let members = backup.members;
		if (type(members) == 'object') {
			for (let k in keys(members)) {
				if (valid_nodeid(k)) {
					let m = members[k];
					if (m) zt_api('POST', '/controller/network/' + new_nwid + '/member/' + k, m);
				}
			}
		} else if (type(members) == 'array') {
			for (let m in members) {
				if (type(m) == 'object') {
					let nodeid = m.id || m.nodeId;
					if (valid_nodeid(nodeid))
						zt_api('POST', '/controller/network/' + new_nwid + '/member/' + nodeid, m);
				}
			}
		}
		print(sprintf('%J\n', { nwid: new_nwid, restored: true }));
		exit(0);
	}
}

exit(1);
